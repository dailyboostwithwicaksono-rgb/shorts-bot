# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit file .env (berisi rahasia).

# --- AI (OpenRouter default; fallback Gemini/DeepSeek jika key diisi) ---
# Dipakai oleh: caption lokal (AI saat caption kosong), prepare lokal (fallback keyword bg), dan alur AI GitHub.
OPENROUTER_API_KEY=
# Opsional: ganti model OpenRouter (default: inclusionai/ling-3.2-flash:free)
# OPENROUTER_MODEL=
# Opsional: provider utama (openrouter | gemini | deepseek). Default: openrouter
# AI_PROVIDER=openrouter
# Opsional fallback:
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Media (lokal) ---
# Dibutuhkan untuk resolve background Pixabay (prepare lokal)
PIXABAY_API_KEY=

# --- YouTube / Drive OAuth (lokal; untuk get_refresh_token & upload/arsip nanti) ---
# Dipakai oleh scripts/get_refresh_token.py di laptopmu.
YT_CLIENT_ID=xxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=xxxxx

# Token per channel (isi manual; JANGAN commit .env). Ambil token dengan:
#   python scripts/get_refresh_token.py --save-key YT_REFRESH_TOKEN        # channel 1 (default)
#   python scripts/get_refresh_token.py --save-key YT_REFRESH_TOKEN_CH2    # channel 2 (tidak menimpa default)
YT_REFRESH_TOKEN=            # Channel 1 (default)
YT_REFRESH_TOKEN_CH2=        # Channel 2 (opsional)

# Pilih token/channel untuk publish (default: YT_REFRESH_TOKEN = channel 1)
# YT_REFRESH_TOKEN_ENV=YT_REFRESH_TOKEN
# YT_REFRESH_TOKEN_ENV=YT_REFRESH_TOKEN_CH2

# --- WoopSocial (Instagram Reels + TikTok, publish LANGSUNG / PUBLISH_NOW) ---
# Dipakai bila PUBLISH_TARGETS menyertakan `woopsocial`. Kunci ini lokal/secret,
# jangan pernah di-commit atau ditempel ke chat.
WOOPSOCIAL_API_KEY=
# Opsional: auto dari akun yang terhubung bila kosong.
# WOOPSOCIAL_PROJECT_ID=
# Opsional: platform yang dipakai (default: instagram,tiktok).
# WOOPSOCIAL_PLATFORMS=instagram,tiktok
# Opsional: pilih akun bila ada lebih dari satu.
# WOOPSOCIAL_IG_ACCOUNT_ID=
# WOOPSOCIAL_TIKTOK_ACCOUNT_ID=
# Opsional: baris link di caption (default: -), flag AI-generated IG (default: 1).
# WOOPSOCIAL_LINK=-
# WOOPSOCIAL_AI_CONTENT=1

# --- Buffer (Facebook Page + Threads; GraphQL shareNow) ---
# Dipakai bila PUBLISH_TARGETS menyertakan `buffer`. Kunci lokal/secret,
# jangan pernah di-commit atau ditempel ke chat.
BUFFER_API_KEY=
# Opsional: organisasi & channel (default: organisasi utama, facebook,threads).
# BUFFER_ORGANIZATION_ID=67966ea2f0cdace9b4192336
# BUFFER_SERVICES=facebook,threads
# BUFFER_MODE=shareNow
# BUFFER_FACEBOOK_POST_TYPE=reel   # post | reel | story (default: reel)
# BUFFER_RELEASE_TAG=media
# BUFFER_ASSET_TTL_HOURS=6
# Opsional: pakai URL video publik sendiri (tanpa upload GitHub Release).
# BUFFER_VIDEO_URL=
# Diperlukan untuk upload Release asset di lokal (di Actions memakai GITHUB_TOKEN).
# GH_TOKEN=

# Token/target lain (opsional):
# DRIVE_REFRESH_TOKEN=
# PUBLISH_TARGETS=youtube            # tambahkan ,woopsocial untuk IG Reels + TikTok
# PUBLISH_DRY_RUN=1
